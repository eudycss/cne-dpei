# =====================================================================
# Sistema de GestiÃ³n de Trazabilidad y LogÃ­stica Electoral
# Variables de entorno - Fase 1
# Copiar a .env y ajustar valores.
# =====================================================================

# --- PostgreSQL (Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cne_imbabura

# URL de conexiÃ³n usada por Prisma (host -> contenedor expuesto en localhost:5432)
# connection_limit: sin este parÃ¡metro, Prisma usa (nÃºm. cores * 2 + 1) conexiones por
# instancia del API. Bajo carga concurrente (ej. muchos operadores enviando tracking a
# la vez) eso puede agotar el pool del motor de Postgres si hay varias instancias del
# API corriendo. Ajustar segÃºn el lÃ­mite de conexiones del proveedor de Postgres en
# producciÃ³n (dividido entre el nÃºmero de instancias del API que se desplieguen).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cne_imbabura?schema=public&connection_limit=10&pool_timeout=10

# --- API NestJS ---
API_PORT=3000
NODE_ENV=development

# CORS (origen del frontend web)
WEB_ORIGIN=http://localhost:5173

# --- JWT ---
# Generar secretos largos en producciÃ³n: openssl rand -hex 64
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Administrador inicial sembrado ---
# El sistema requiere al menos un admin para crear el resto de usuarios (HU7).
ADMIN_EMAIL=admin@cne-imbabura.gob.ec
ADMIN_CEDULA=1000000000
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=del Sistema
ADMIN_INITIAL_PASSWORD=Admin*Inicial2026

# ContraseÃ±a por defecto al restablecer la clave de un usuario (acciÃ³n de admin).
# El usuario deberÃ¡ cambiarla en su prÃ³ximo inicio de sesiÃ³n.
DEFAULT_RESET_PASSWORD=Cne2026!

# --- Almacenamiento de archivos cifrados (HU3-CA2) ---
# Se guardan en un bucket privado de Supabase Storage (persistente). El
# contenido se cifra antes de subirse: Supabase nunca ve el archivo en claro.
# Clave AES-256-GCM: exactamente 64 caracteres hex (32 bytes).
# Generar nueva clave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=cambia_esto_genera_con_el_comando_de_arriba
# URL del proyecto Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Service role key (Project Settings -> API -> service_role) — NUNCA exponer al frontend
SUPABASE_SERVICE_ROLE_KEY=cambia_esto_service_role_key
# Bucket privado donde se guardan los archivos cifrados (crear si no existe)
SUPABASE_STORAGE_BUCKET=archivos-cifrados

# --- Correo (Brevo API) ---
# API key de Brevo (transactional email). Generar en: app.brevo.com â†’ SMTP & API â†’ API Keys
# Si no se define, el sistema usa ConsoleNotifier (imprime los correos en el log).
BREVO_API_KEY=
BREVO_FROM_EMAIL=tucuenta@gmail.com
BREVO_FROM_NAME=CNE Imbabura

# --- Alertas de enlaces caídos (CDAs Imbabura) ---
# Cuenta de servicio de Google Cloud con acceso de Lector a la hoja de
# enlaces (Google Sheets API habilitada). Contenido completo del JSON de la
# clave, en una sola línea.
GOOGLE_SHEETS_CREDENTIALS_JSON=
# ID de la hoja (el segmento entre /d/ y /edit en la URL de Google Sheets).
GOOGLE_SHEETS_ID=
# Nombre de la pestaña con el detalle de enlaces. Por defecto "INF".
GOOGLE_SHEETS_TAB_INF=INF

# Bot de Telegram (@BotFather) y chat/grupo donde se envían los avisos de
# enlaces caídos. Si se dejan vacíos, el aviso a Telegram se omite sin error.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto para validar que las llamadas a POST /enlaces/telegram/webhook
# realmente vienen de Telegram (se registra como "secret_token" al configurar
# el webhook con setWebhook). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin este valor, el webhook ignora cualquier comando entrante.
TELEGRAM_WEBHOOK_SECRET=

# --- Web (Vite) ---
# Apunta al backend NestJS
VITE_API_URL=http://localhost:3000
