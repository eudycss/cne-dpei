# =====================================================================
# Sistema de Gestión de Trazabilidad y Logística Electoral
# Variables de entorno - Fase 1
# Copiar a .env y ajustar valores.
# =====================================================================

# --- PostgreSQL (Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cne_imbabura

# URL de conexión usada por Prisma (host -> contenedor expuesto en localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cne_imbabura?schema=public

# --- API NestJS ---
API_PORT=3000
NODE_ENV=development

# CORS (origen del frontend web)
WEB_ORIGIN=http://localhost:5173

# --- JWT ---
# Generar secretos largos en producción: openssl rand -hex 64
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Administrador inicial sembrado ---
# El sistema requiere al menos un admin para crear el resto de usuarios (HU7).
ADMIN_EMAIL=admin@cne-imbabura.gob.ec
ADMIN_CEDULA=1000000000
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=del Sistema
ADMIN_INITIAL_PASSWORD=Admin*Inicial2026

# Contraseña por defecto al restablecer la clave de un usuario (acción de admin).
# El usuario deberá cambiarla en su próximo inicio de sesión.
DEFAULT_RESET_PASSWORD=CneImbabura2026*

# --- Almacenamiento de archivos cifrados (HU3-CA2) ---
# Clave AES-256-GCM: exactamente 64 caracteres hex (32 bytes).
# Generar nueva clave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=cambia_esto_genera_con_el_comando_de_arriba
# Directorio donde se guardan los archivos cifrados (relativo a apps/api o absoluto)
STORAGE_DIR=storage

# --- Correo (Gmail SMTP) ---
# Cuenta Gmail que envía los correos y contraseña de aplicación (no la contraseña normal).
# Generar en: myaccount.google.com → Seguridad → Contraseñas de aplicación
MAIL_USER=tucuenta@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx

# --- Web (Vite) ---
# Apunta al backend NestJS
VITE_API_URL=http://localhost:3000
