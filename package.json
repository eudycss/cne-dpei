{
  "name": "cne-imbabura",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestión de Trazabilidad y Logística Electoral — CNE Imbabura",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "pnpm run sync-env && pnpm --filter @cne/api db:migrate",
    "db:seed": "pnpm run sync-env && pnpm --filter @cne/api db:seed",
    "sync-env": "node scripts/sync-env.js",
    "dev:api": "pnpm run sync-env && pnpm --filter @cne/api dev",
    "dev:web": "pnpm --filter @cne/web dev",
    "dev:mobile": "pnpm --filter @cne/mobile start",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@react-native/assets-registry": "0.74.87"
  },
  "pnpm": {
    "overrides": {
      "yargs": "^17.6.2"
    }
  }
}
