# =====================================================================
# Variables de entorno de la app móvil (Expo)
# Copiar a .env y ajustar valores. Solo las variables con prefijo
# EXPO_PUBLIC_ se inyectan en el bundle del cliente.
# =====================================================================

# URL base del backend NestJS.
#
# - Emulador Android:  puedes omitir esta variable; el cliente traduce
#                      localhost -> 10.0.2.2 automáticamente.
# - Simulador iOS:     http://localhost:3000
# - Dispositivo físico: la IP LAN de la PC donde corre el API. El teléfono
#                       y la PC deben estar en la MISMA red Wi-Fi.
#
# Cómo obtener la IP de la PC:
#   Windows:  ipconfig   (busca "Dirección IPv4" del adaptador activo)
#   macOS:    ipconfig getifaddr en0
#   Linux:    hostname -I
#
# Ejemplo:
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
