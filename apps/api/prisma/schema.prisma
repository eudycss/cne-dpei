// =====================================================================
// Schema Prisma — derivado de modelo_datos.sql
// PostgreSQL 16 + PostGIS 3.4
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), postgis]
}

// =====================================================================
// ENUMS
// =====================================================================
enum TipoRecinto {
  CDA
  NO_CDA

  @@map("tipo_recinto")
}

enum EstadoEvento {
  BORRADOR
  ACTIVO
  CERRADO

  @@map("estado_evento")
}

enum TipoEventoElectoral {
  ELECCION_GENERAL
  SEGUNDA_VUELTA
  CONSULTA_POPULAR
  REFERENDUM
  ELECCIONES_SECCIONALES
  OTRO

  @@map("tipo_evento_electoral")
}

enum EstadoKit {
  EN_BODEGA
  ASIGNADO
  ENTREGADO
  EN_RECINTO
  EN_RETORNO
  RETORNADO

  @@map("estado_kit")
}

enum TipoTracking {
  SALIDA_DPI
  LLEGADA_RECINTO
  SALIDA_RECINTO
  LLEGADA_DPI
  LLEGADA_NO_CDA

  @@map("tipo_tracking")
}

enum TipoIncidencia {
  KIT_DANADO
  KIT_FALTANTE
  PROBLEMA_RECINTO
  RETRASO
  PROBLEMA_SEGURIDAD
  OTRO

  @@map("tipo_incidencia")
}

enum EstadoIncidencia {
  ABIERTA
  ATENDIDA
  CERRADA

  @@map("estado_incidencia")
}

enum TipoAlerta {
  NO_LLEGO_RECINTO
  NO_LLEGO_DPI
  SIN_SINCRONIZAR
  KIT_NO_CORRESPONDE

  @@map("tipo_alerta")
}

enum EstadoAlerta {
  GENERADA
  VISTA
  ATENDIDA

  @@map("estado_alerta")
}

enum CanalNotificacion {
  PUSH
  EMAIL

  @@map("canal_notificacion")
}

enum EstadoNotificacion {
  ENCOLADA
  ENVIADA
  ENTREGADA
  FALLIDA

  @@map("estado_notificacion")
}

enum PlataformaDisp {
  ANDROID
  IOS

  @@map("plataforma_disp")
}

// =====================================================================
// IDENTIDAD Y ACCESO (HU1, HU7, HU9, HU16)
// =====================================================================
model Usuario {
  id             String   @id @default(uuid()) @db.Uuid
  cedula         String   @unique @db.VarChar(10)
  email          String   @unique @db.VarChar(255)
  nombres        String   @db.VarChar(120)
  apellidos      String   @db.VarChar(120)
  telefono       String?  @db.VarChar(20)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  debeCambiarPwd Boolean  @default(true) @map("debe_cambiar_pwd")
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  roles               UsuarioRol[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  dispositivos        Dispositivo[]

  @@map("usuarios")
}

model Rol {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique @db.VarChar(40)

  usuarios UsuarioRol[]

  @@map("roles")
}

model UsuarioRol {
  usuarioId String @map("usuario_id") @db.Uuid
  rolId     String @map("rol_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_roles")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(6)
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "idx_reset_tokens_usuario")
  @@map("password_reset_tokens")
}

// Refresh tokens persistidos para poder revocarlos en logout (no está en modelo_datos.sql,
// se agrega para soportar HU1-CA4 y logout seguro).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  jti       String    @unique @db.VarChar(64)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(6)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Dispositivo {
  id         String         @id @default(uuid()) @db.Uuid
  usuarioId  String         @map("usuario_id") @db.Uuid
  fcmToken   String         @unique @map("fcm_token") @db.VarChar(512)
  plataforma PlataformaDisp
  activo     Boolean        @default(true)
  creadoEn   DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("dispositivos")
}

// =====================================================================
// GEOGRAFÍA ELECTORAL
// =====================================================================
model Canton {
  id     Int    @id @default(autoincrement())
  codigo String @unique @db.VarChar(10)
  nombre String @db.VarChar(80)

  recintos Recinto[]

  @@map("cantones")
}

model Recinto {
  id              String      @id @default(uuid()) @db.Uuid
  codigoRecinto   String      @unique @map("codigo_recinto") @db.VarChar(20)
  nombre          String      @db.VarChar(255)
  direccion       String?     @db.VarChar(255)
  cantonId        Int         @map("canton_id")
  parroquia       String?     @db.VarChar(120)
  zona            String?     @db.VarChar(120)
  tipo            TipoRecinto
  cdaDestinoId    String?     @map("cda_destino_id") @db.Uuid
  // El tipo PostGIS GEOGRAPHY(POINT, 4326) se modela como Unsupported.
  // Acceso geoespacial vía $queryRaw cuando entren las HU de tracking.
  ubicacion       Unsupported("geography(Point,4326)")
  tieneInternet   Boolean     @default(false) @map("tiene_internet")
  coberturaMovil  Boolean     @default(false) @map("cobertura_movil")
  distanciaDpiKm  Decimal?    @map("distancia_dpi_km") @db.Decimal(6, 2)
  tiempoDpiMin    Int?        @map("tiempo_dpi_min")
  numeroElectores    Int?        @map("numero_electores")
  juntasFemeninas    Int?        @map("juntas_femeninas")
  juntasMasculinas   Int?        @map("juntas_masculinas")
  esDificilAcceso    Boolean     @default(false) @map("es_dificil_acceso")

  canton     Canton    @relation(fields: [cantonId], references: [id])
  cdaDestino Recinto?  @relation("CdaDestino", fields: [cdaDestinoId], references: [id])
  origenes   Recinto[] @relation("CdaDestino")
  militares  Militar[]

  @@index([cantonId], map: "idx_recintos_canton")
  @@index([tipo], map: "idx_recintos_tipo")
  @@map("recintos")
}

model Militar {
  id        String   @id @default(uuid()) @db.Uuid
  cedula    String   @db.VarChar(10)
  nombres   String   @db.VarChar(120)
  apellidos String   @db.VarChar(120)
  recintoId String   @map("recinto_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  recinto Recinto @relation(fields: [recintoId], references: [id])

  @@index([recintoId], map: "idx_militares_recinto")
  @@map("militares")
}

// =====================================================================
// EVENTOS ELECTORALES (HU20)
// =====================================================================
model EventoElectoral {
  id           String              @id @default(uuid()) @db.Uuid
  nombre       String              @db.VarChar(160)
  tipo         TipoEventoElectoral
  fechaJornada DateTime            @map("fecha_jornada") @db.Date
  descripcion  String?
  estado       EstadoEvento        @default(BORRADOR)
  creadoEn     DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  cerradoEn    DateTime?           @map("cerrado_en") @db.Timestamptz(6)

  @@map("eventos_electorales")
}

model ConfigAlerta {
  eventoId                 String @id @map("evento_id") @db.Uuid
  umbralLlegadaRecintoMin Int    @default(120) @map("umbral_llegada_recinto_min")
  umbralLlegadaDpiMin     Int    @default(120) @map("umbral_llegada_dpi_min")
  umbralSinSyncMin        Int    @default(30) @map("umbral_sin_sync_min")

  @@map("config_alertas")
}

// =====================================================================
// KITS ELECTORALES (HU11, HU12)
// =====================================================================
model KitElectoral {
  id           String    @id @default(uuid()) @db.Uuid
  eventoId     String    @map("evento_id") @db.Uuid
  codigoUnico  String    @map("codigo_unico") @db.VarChar(40)
  qrPayload    String    @map("qr_payload") @db.VarChar(255)
  nombre       String    @db.VarChar(160)
  contenidos   String?
  recintoId    String?   @map("recinto_id") @db.Uuid
  operadorId   String?   @map("operador_id") @db.Uuid
  estado       EstadoKit @default(EN_BODEGA)
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@unique([eventoId, codigoUnico])
  @@index([eventoId], map: "idx_kits_evento")
  @@index([recintoId], map: "idx_kits_recinto")
  @@index([operadorId], map: "idx_kits_operador")
  @@map("kits_electorales")
}

// =====================================================================
// ASIGNACIONES OPERADOR ↔ SUPERVISOR (HU10)
// =====================================================================
model AsignacionSupervisor {
  id           String   @id @default(uuid()) @db.Uuid
  eventoId     String   @map("evento_id") @db.Uuid
  operadorId   String   @map("operador_id") @db.Uuid
  supervisorId String   @map("supervisor_id") @db.Uuid
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@unique([eventoId, operadorId])
  @@map("asignaciones_supervisor")
}

// =====================================================================
// TRACKING (HU2–HU6)
// =====================================================================
model EventoTracking {
  id           String       @id @default(uuid()) @db.Uuid
  eventoId     String       @map("evento_id") @db.Uuid
  operadorId   String       @map("operador_id") @db.Uuid
  tipo         TipoTracking
  recintoId    String?      @map("recinto_id") @db.Uuid
  ubicacion    Unsupported("geography(Point,4326)")?
  ocurridoEn   DateTime     @map("ocurrido_en") @db.Timestamptz(6)
  desdeOffline Boolean      @default(false) @map("desde_offline")
  registradoEn DateTime     @default(now()) @map("registrado_en") @db.Timestamptz(6)

  @@index([operadorId, eventoId], map: "idx_tracking_operador")
  @@index([tipo], map: "idx_tracking_tipo")
  @@map("eventos_tracking")
}

model RecepcionKit {
  id              String   @id @default(uuid()) @db.Uuid
  kitId           String   @map("kit_id") @db.Uuid
  operadorId      String   @map("operador_id") @db.Uuid
  militarId       String?  @map("militar_id") @db.Uuid
  fotoMilitarUrl  String?  @map("foto_militar_url") @db.VarChar(512)
  ubicacion       Unsupported("geography(Point,4326)")?
  confirmadoEn    DateTime @default(now()) @map("confirmado_en") @db.Timestamptz(6)
  desdeOffline    Boolean  @default(false) @map("desde_offline")

  @@index([kitId], map: "idx_recepciones_kit")
  @@map("recepciones_kit")
}

model RecepcionDpiKit {
  id            String   @id @default(uuid()) @db.Uuid
  kitId         String   @map("kit_id") @db.Uuid
  supervisorId  String   @map("supervisor_id") @db.Uuid
  items         Json
  observaciones String?  @db.VarChar(500)
  confirmadoEn  DateTime @default(now()) @map("confirmado_en") @db.Timestamptz(6)

  @@index([kitId], map: "idx_recepciones_dpi_kit")
  @@map("recepciones_dpi_kit")
}

model PosicionGps {
  id           BigInt   @id @default(autoincrement())
  operadorId   String   @map("operador_id") @db.Uuid
  eventoId     String   @map("evento_id") @db.Uuid
  ubicacion    Unsupported("geography(Point,4326)")
  capturadoEn  DateTime @map("capturado_en") @db.Timestamptz(6)
  recibidoEn   DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)

  @@index([operadorId, capturadoEn], map: "idx_posiciones_operador")
  @@map("posiciones_gps")
}

// =====================================================================
// INCIDENCIAS (HU14)
// =====================================================================
model Incidencia {
  id           String           @id @default(uuid()) @db.Uuid
  eventoId     String           @map("evento_id") @db.Uuid
  operadorId   String           @map("operador_id") @db.Uuid
  recintoId    String?          @map("recinto_id") @db.Uuid
  kitId        String?          @map("kit_id") @db.Uuid
  tipo         TipoIncidencia
  descripcion  String?
  fotoUrl      String?          @map("foto_url") @db.VarChar(512)
  ubicacion    Unsupported("geography(Point,4326)")?
  estado       EstadoIncidencia @default(ABIERTA)
  reportadoEn  DateTime         @default(now()) @map("reportado_en") @db.Timestamptz(6)
  desdeOffline Boolean          @default(false) @map("desde_offline")

  comentarios IncidenciaComentario[]

  @@index([eventoId], map: "idx_incidencias_evento")
  @@index([estado], map: "idx_incidencias_estado")
  @@map("incidencias")
}

model IncidenciaComentario {
  id            String   @id @default(uuid()) @db.Uuid
  incidenciaId  String   @map("incidencia_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  comentario    String
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)

  @@map("incidencia_comentarios")
}

// =====================================================================
// ALERTAS (HU18)
// =====================================================================
model Alerta {
  id          String       @id @default(uuid()) @db.Uuid
  eventoId    String       @map("evento_id") @db.Uuid
  operadorId  String?      @map("operador_id") @db.Uuid
  kitId       String?      @map("kit_id") @db.Uuid
  tipo        TipoAlerta
  mensaje     String       @db.VarChar(255)
  estado      EstadoAlerta @default(GENERADA)
  generadaEn  DateTime     @default(now()) @map("generada_en") @db.Timestamptz(6)

  @@index([eventoId, estado], map: "idx_alertas_evento")
  @@map("alertas")
}

// =====================================================================
// NOTIFICACIONES (HU19)
// =====================================================================
model PreferenciaNotificacion {
  usuarioId  String  @map("usuario_id") @db.Uuid
  tipoEvento String  @map("tipo_evento") @db.VarChar(60)
  porPush    Boolean @default(true) @map("por_push")
  porEmail   Boolean @default(true) @map("por_email")

  @@id([usuarioId, tipoEvento])
  @@map("preferencias_notificacion")
}

model Notificacion {
  id         String             @id @default(uuid()) @db.Uuid
  usuarioId  String             @map("usuario_id") @db.Uuid
  tipoEvento String             @map("tipo_evento") @db.VarChar(60)
  canal      CanalNotificacion
  estado     EstadoNotificacion @default(ENCOLADA)
  intentos   Int                @default(0)
  payload    Json?
  creadoEn   DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)
  enviadoEn  DateTime?          @map("enviado_en") @db.Timestamptz(6)
  leidaEn    DateTime?          @map("leida_en") @db.Timestamptz(6)

  @@index([usuarioId], map: "idx_notificaciones_usuario")
  @@map("notificaciones")
}

// =====================================================================
// BITÁCORA DE AUDITORÍA (HU17) — append-only
// =====================================================================
model BitacoraAuditoria {
  id           BigInt   @id @default(autoincrement())
  usuarioId    String?  @map("usuario_id") @db.Uuid
  accion       String   @db.VarChar(80)
  entidad      String?  @db.VarChar(60)
  entidadId    String?  @map("entidad_id") @db.VarChar(60)
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  dispositivo  String?  @db.VarChar(160)
  ip           String?  @db.Inet
  ubicacion    Unsupported("geography(Point,4326)")?
  ocurridoEn   DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  @@index([usuarioId], map: "idx_bitacora_usuario")
  @@index([entidad, entidadId], map: "idx_bitacora_entidad")
  @@index([ocurridoEn], map: "idx_bitacora_fecha")
  @@map("bitacora_auditoria")
}
