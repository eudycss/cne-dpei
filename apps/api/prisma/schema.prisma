// =====================================================================
// Schema Prisma — derivado de modelo_datos.sql
// PostgreSQL 16 + PostGIS 3.4
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), postgis]
}

// =====================================================================
// ENUMS
// =====================================================================
enum TipoRecinto {
  CDA
  NO_CDA

  @@map("tipo_recinto")
}

enum EstadoEvento {
  BORRADOR
  ACTIVO
  CERRADO

  @@map("estado_evento")
}

enum EstadoKit {
  EN_BODEGA
  ASIGNADO
  ENTREGADO
  EN_RECINTO
  EN_RETORNO
  RETORNADO

  @@map("estado_kit")
}

// Estado físico de cada artículo del kit (laptop, escáner…) en el acta de
// entrega/recepción. Al retorno el asistente puede registrar otro estado; ese
// queda en RecepcionDpiKit.items, no aquí.
enum EstadoItemKit {
  BUENO
  REGULAR
  MALO

  @@map("estado_item_kit")
}

enum TipoTracking {
  SALIDA_DPI
  LLEGADA_RECINTO
  SALIDA_RECINTO
  LLEGADA_DPI
  LLEGADA_NO_CDA
  PRUEBA_CONEXION

  @@map("tipo_tracking")
}

enum TipoIncidencia {
  KIT_DANADO
  KIT_FALTANTE
  PROBLEMA_RECINTO
  RETRASO
  PROBLEMA_SEGURIDAD
  OTRO

  @@map("tipo_incidencia")
}

enum EstadoIncidencia {
  ABIERTA
  ATENDIDA
  CERRADA

  @@map("estado_incidencia")
}

enum TipoAlerta {
  NO_LLEGO_RECINTO
  NO_LLEGO_DPI
  SIN_SINCRONIZAR
  KIT_NO_CORRESPONDE
  ENTREGA_MILITAR_NO_REGISTRADA
  LLEGADA_RECINTO_FUERA_DE_RANGO
  LLEGADA_DPI_FUERA_DE_RANGO

  @@map("tipo_alerta")
}

// Qué se corrigió en la cadena de custodia de un kit (historial con motivo).
enum CampoCorreccionCustodia {
  MILITAR
  OPERADOR

  @@map("campo_correccion_custodia")
}

enum EstadoAlerta {
  GENERADA
  VISTA
  ATENDIDA

  @@map("estado_alerta")
}

enum CanalNotificacion {
  PUSH
  EMAIL

  @@map("canal_notificacion")
}

enum EstadoNotificacion {
  ENCOLADA
  ENVIADA
  ENTREGADA
  FALLIDA

  @@map("estado_notificacion")
}

enum PlataformaDisp {
  ANDROID
  IOS

  @@map("plataforma_disp")
}

// =====================================================================
// IDENTIDAD Y ACCESO (HU1, HU7, HU9, HU16)
// =====================================================================
model Usuario {
  id             String   @id @default(uuid()) @db.Uuid
  cedula         String   @unique @db.VarChar(10)
  /// Opcional: las cuentas de Operadores/Asistentes CDA entran solo con cédula.
  email          String?  @unique @db.VarChar(255)
  nombres        String   @db.VarChar(120)
  apellidos      String   @db.VarChar(120)
  telefono       String?  @db.VarChar(20)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  debeCambiarPwd Boolean  @default(true) @map("debe_cambiar_pwd")
  activo         Boolean  @default(true)
  /// Contraseñas erróneas seguidas; al llegar al máximo se bloquea un rato.
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  roles               UsuarioRol[]
  operadorCda         OperadorCda?
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  dispositivos        Dispositivo[]
  kitsAsignados       KitElectoral[]
  parejasCdaCreadas   ParejaCda[]     @relation("ParejaCdaCreadaPor")

  asistenciasCdaEntrada AsistenciaCda[]  @relation("AsistenciaCdaEntradaPor")
  asistenciasCdaSalida  AsistenciaCda[]  @relation("AsistenciaCdaSalidaPor")
  enlacesFotoCda        EnlaceFotoCda[]  @relation("EnlaceFotoCdaCreadoPor")
  credencialesQrCda     CredencialQrCda[] @relation("CredencialQrCdaEmitidaPor")
  actasCdaEntregadas    ActaEntregaCda[] @relation("ActaEntregaCdaEntregaPor")
  actasCdaCreadas       ActaEntregaCda[] @relation("ActaEntregaCdaCreadoPor")
  cambiosCargoCda       CambioCargoCda[] @relation("CambioCargoCdaHechoPor")
  llegadasDpiManuales   EventoTracking[] @relation("LlegadaDpiManualPor")

  @@map("usuarios")
}

model Rol {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique @db.VarChar(40)

  usuarios UsuarioRol[]
  modulos  RolModulo[]
  permisos RolPermiso[]

  @@map("roles")
}

/// Módulo de la web visible para un rol (existe la fila = se muestra). Lo edita
/// el administrador; el catálogo y el techo por rol están en @cne/shared-validation.
model RolModulo {
  rolId  String @map("rol_id") @db.Uuid
  modulo String @db.VarChar(40)

  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, modulo])
  @@map("rol_modulos")
}

/// Acciones dentro de un módulo que el administrador le da a cada rol (ver PERMISOS en shared-validation).
model RolPermiso {
  rolId   String @map("rol_id") @db.Uuid
  permiso String @db.VarChar(40)

  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, permiso])
  @@map("rol_permisos")
}

model UsuarioRol {
  usuarioId String @map("usuario_id") @db.Uuid
  rolId     String @map("rol_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_roles")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(6)
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "idx_reset_tokens_usuario")
  @@map("password_reset_tokens")
}

// Refresh tokens persistidos para poder revocarlos en logout (no está en modelo_datos.sql,
// se agrega para soportar HU1-CA4 y logout seguro).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  jti       String    @unique @db.VarChar(64)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(6)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Dispositivo {
  id         String         @id @default(uuid()) @db.Uuid
  usuarioId  String         @map("usuario_id") @db.Uuid
  fcmToken   String         @unique @map("fcm_token") @db.VarChar(512)
  plataforma PlataformaDisp
  activo     Boolean        @default(true)
  creadoEn   DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("dispositivos")
}

// =====================================================================
// GEOGRAFÍA ELECTORAL
// =====================================================================
model Canton {
  id     Int    @id @default(autoincrement())
  codigo String @unique @db.VarChar(10)
  nombre String @db.VarChar(80)

  recintos Recinto[]

  @@map("cantones")
}

model Recinto {
  id              String      @id @default(uuid()) @db.Uuid
  codigoRecinto   String      @unique @map("codigo_recinto") @db.VarChar(20)
  nombre          String      @db.VarChar(255)
  direccion       String?     @db.VarChar(255)
  cantonId        Int         @map("canton_id")
  parroquia       String?     @db.VarChar(120)
  zona            String?     @db.VarChar(120)
  tipo            TipoRecinto
  cdaDestinoId    String?     @map("cda_destino_id") @db.Uuid
  // El tipo PostGIS GEOGRAPHY(POINT, 4326) se modela como Unsupported.
  // Acceso geoespacial vía $queryRaw cuando entren las HU de tracking.
  ubicacion       Unsupported("geography(Point,4326)")
  tieneInternet   Boolean     @default(false) @map("tiene_internet")
  coberturaMovil  Boolean     @default(false) @map("cobertura_movil")
  distanciaDpiKm  Decimal?    @map("distancia_dpi_km") @db.Decimal(6, 2)
  tiempoDpiMin    Int?        @map("tiempo_dpi_min")
  numeroElectores    Int?        @map("numero_electores")
  juntasFemeninas    Int?        @map("juntas_femeninas")
  juntasMasculinas   Int?        @map("juntas_masculinas")
  esDificilAcceso    Boolean     @default(false) @map("es_dificil_acceso")
  /// CDA: a dónde dirigirse si hay un problema con el kit (texto libre; la sync del Sheet no lo toca).
  contingenciaNombre    String?  @map("contingencia_nombre") @db.VarChar(255)
  contingenciaDireccion String?  @map("contingencia_direccion") @db.VarChar(255)
  /// false = ya no está en el Google Sheet de recintos: se oculta de listas y
  /// asignaciones, pero se conserva por el historial (kits, tracking, actas).
  activo             Boolean     @default(true)

  canton     Canton         @relation(fields: [cantonId], references: [id])
  cdaDestino Recinto?       @relation("CdaDestino", fields: [cdaDestinoId], references: [id])
  origenes   Recinto[]      @relation("CdaDestino")
  militares  Militar[]
  kits       KitElectoral[]
  parejasCda ParejaCda[]

  @@index([cantonId], map: "idx_recintos_canton")
  @@index([tipo], map: "idx_recintos_tipo")
  @@index([activo], map: "idx_recintos_activo")
  @@map("recintos")
}

model Militar {
  id        String   @id @default(uuid()) @db.Uuid
  cedula    String   @db.VarChar(10)
  nombres   String   @db.VarChar(120)
  apellidos String   @db.VarChar(120)
  recintoId String   @map("recinto_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  recinto Recinto @relation(fields: [recintoId], references: [id])

  entregasCustodio EntregaCustodioKit[]

  @@index([recintoId], map: "idx_militares_recinto")
  @@map("militares")
}

// =====================================================================
// EVENTOS ELECTORALES (HU20)
// =====================================================================
model TipoEventoCatalog {
  id       String  @id @default(uuid()) @db.Uuid
  codigo   String  @unique @db.VarChar(50)
  etiqueta String  @db.VarChar(120)
  activo   Boolean @default(true)

  @@map("tipos_evento_electoral")
}

model EventoElectoral {
  id           String       @id @default(uuid()) @db.Uuid
  nombre       String       @db.VarChar(160)
  tipo         String       @db.VarChar(50)
  fechaJornada DateTime     @map("fecha_jornada") @db.Date
  descripcion  String?
  estado       EstadoEvento        @default(BORRADOR)
  creadoEn     DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  cerradoEn    DateTime?           @map("cerrado_en") @db.Timestamptz(6)
  // Evento cerrado que se reabrió solo para consulta: la app móvil no puede
  // registrar y el cron de alertas lo ignora. Vuelve a null al cerrarlo.
  reabiertoEn  DateTime?           @map("reabierto_en") @db.Timestamptz(6)

  @@map("eventos_electorales")
}

model ConfigAlerta {
  eventoId                String  @id @map("evento_id") @db.Uuid
  umbralLlegadaRecintoMin Int     @default(120) @map("umbral_llegada_recinto_min")
  umbralLlegadaDpiMin     Int     @default(120) @map("umbral_llegada_dpi_min")
  umbralSinSyncMin        Int     @default(30) @map("umbral_sin_sync_min")
  margenLlegadaMetros     Int     @default(150) @map("margen_llegada_metros")
  margenLlegadaDpiMetros  Int     @default(150) @map("margen_llegada_dpi_metros")
  // Coordenada de la Delegación Provincial Electoral de Imbabura, usada para
  // validar la geocerca de "llegada al DPI" (HU5). Nullable a propósito: hasta
  // que se cargue el valor real, registrarLlegadaDpi no debe bloquear nada
  // (ver tracking.service.ts).
  delegacionUbicacion     Unsupported("geography(Point,4326)")?

  @@map("config_alertas")
}

// =====================================================================
// KITS ELECTORALES (HU11, HU12)
// =====================================================================
model KitElectoral {
  id           String    @id @default(uuid()) @db.Uuid
  eventoId     String    @map("evento_id") @db.Uuid
  codigoUnico  String    @map("codigo_unico") @db.VarChar(40)
  qrPayload    String    @map("qr_payload") @db.VarChar(255)
  nombre       String    @db.VarChar(160)
  contenidos   String?
  recintoId    String?   @map("recinto_id") @db.Uuid
  operadorId   String?   @map("operador_id") @db.Uuid
  estado       EstadoKit @default(EN_BODEGA)
  esPrueba     Boolean   @default(false) @map("es_prueba")
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  // SetNull: si se borra el recinto/operador, el kit queda sin asignar en vez
  // de bloquear el delete o borrarse en cascada. Un recinto puede tener varios
  // kits (y por lo tanto varios operadores, ej. los 2 operadores por CDA).
  recinto  Recinto? @relation(fields: [recintoId], references: [id], onDelete: SetNull)
  operador Usuario? @relation(fields: [operadorId], references: [id], onDelete: SetNull)
  // `contenidos` (texto libre) queda como legacy: kits creados antes de esta
  // relación lo siguen mostrando tal cual. Los kits nuevos usan itemsContenido.
  itemsContenido KitItemContenido[]
  entregaCustodio      EntregaCustodioKit?
  correccionesCustodia CorreccionCustodiaKit[]
  parejasCda           ParejaCda[]

  @@unique([eventoId, codigoUnico])
  @@index([eventoId], map: "idx_kits_evento")
  @@index([recintoId], map: "idx_kits_recinto")
  @@index([operadorId], map: "idx_kits_operador")
  @@map("kits_electorales")
}

// Catálogo editable de tipos de ítem de kit (ej. Computador, Impresora) — CRUD
// por ADMINISTRADOR, mismo patrón que TipoEventoCatalog.
model ItemKitCatalog {
  id       String  @id @default(uuid()) @db.Uuid
  codigo   String  @unique @db.VarChar(50)
  etiqueta String  @db.VarChar(120)
  activo   Boolean @default(true)

  kits KitItemContenido[]

  @@map("items_kit_catalog")
}

// Relación kit↔item: qué ítems del catálogo trae cada kit. Sin id propio ni
// campos extra (cantidad/orden) — la clave natural [kitId, itemId] alcanza.
model KitItemContenido {
  kitId  String        @map("kit_id") @db.Uuid
  itemId String        @map("item_id") @db.Uuid
  // Número de serie del artículo en este kit; NULL = sin serie ("S/N" en el acta).
  serie  String?       @db.VarChar(60)
  estado EstadoItemKit @default(BUENO)

  kit  KitElectoral   @relation(fields: [kitId], references: [id], onDelete: Cascade)
  item ItemKitCatalog @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([kitId, itemId])
  @@index([itemId], map: "idx_kit_items_item")
  @@map("kit_items_contenido")
}

// =====================================================================
// ASIGNACIONES OPERADOR ↔ SUPERVISOR (HU10)
// =====================================================================
model AsignacionSupervisor {
  id           String   @id @default(uuid()) @db.Uuid
  eventoId     String   @map("evento_id") @db.Uuid
  operadorId   String   @map("operador_id") @db.Uuid
  supervisorId String   @map("supervisor_id") @db.Uuid
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@unique([eventoId, operadorId])
  @@map("asignaciones_supervisor")
}

// =====================================================================
// TRACKING (HU2–HU6)
// =====================================================================
model EventoTracking {
  id           String       @id @default(uuid()) @db.Uuid
  eventoId     String       @map("evento_id") @db.Uuid
  operadorId   String       @map("operador_id") @db.Uuid
  tipo         TipoTracking
  recintoId    String?      @map("recinto_id") @db.Uuid
  ubicacion    Unsupported("geography(Point,4326)")?
  ocurridoEn   DateTime     @map("ocurrido_en") @db.Timestamptz(6)
  desdeOffline Boolean      @default(false) @map("desde_offline")
  registradoEn DateTime     @default(now()) @map("registrado_en") @db.Timestamptz(6)
  // Solo se llenan en la fila tipo=SALIDA_RECINTO: evidencia obligatoria de
  // las actas antes de poder registrar la salida del recinto.
  actaInstalacionUrl String? @map("acta_instalacion_url") @db.VarChar(512)
  actaEscrutinioUrl  String? @map("acta_escrutinio_url") @db.VarChar(512)
  // Solo en la fila tipo=PRUEBA_CONEXION: foto de la computadora donde se hizo
  // el test (obligatoria en la app; opcional en el servidor por las APK viejas).
  fotoPruebaConexionUrl String? @map("foto_prueba_conexion_url") @db.VarChar(512)
  // Solo en una LLEGADA_DPI registrada desde la web por un administrador
  // (el operador olvidó marcarla): quién la registró y por qué.
  registradoPorId String?  @map("registrado_por_id") @db.Uuid
  motivoManual    String?  @map("motivo_manual") @db.VarChar(500)
  registradoPor   Usuario? @relation("LlegadaDpiManualPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([operadorId, eventoId], map: "idx_tracking_operador")
  @@index([tipo], map: "idx_tracking_tipo")
  @@map("eventos_tracking")
}

model RecepcionKit {
  id              String   @id @default(uuid()) @db.Uuid
  kitId           String   @map("kit_id") @db.Uuid
  operadorId      String   @map("operador_id") @db.Uuid
  militarId       String?  @map("militar_id") @db.Uuid
  fotoMilitarUrl  String?  @map("foto_militar_url") @db.VarChar(512)
  ubicacion       Unsupported("geography(Point,4326)")?
  confirmadoEn    DateTime @default(now()) @map("confirmado_en") @db.Timestamptz(6)
  desdeOffline    Boolean  @default(false) @map("desde_offline")

  @@index([kitId], map: "idx_recepciones_kit")
  @@map("recepciones_kit")
}

// Cadena de custodia, paso 1: el Asistente Electoral Transversal entrega el kit
// a un militar en el DPEI. Uno por kit; las correcciones van al historial.
model EntregaCustodioKit {
  id                   String   @id @default(uuid()) @db.Uuid
  kitId                String   @unique @map("kit_id") @db.Uuid
  eventoId             String   @map("evento_id") @db.Uuid
  militarId            String   @map("militar_id") @db.Uuid
  entregadoPorId       String   @map("entregado_por_id") @db.Uuid
  entregadoEn          DateTime @default(now()) @map("entregado_en") @db.Timestamptz(6)
  // El militar no estaba asignado al recinto del kit (cambio de último minuto).
  militarDeOtroRecinto Boolean  @default(false) @map("militar_de_otro_recinto")

  // Restrict: la entrega es evidencia de custodia; no se borra con el kit ni
  // se borra un militar que recibió un kit.
  kit     KitElectoral @relation(fields: [kitId], references: [id], onDelete: Restrict)
  militar Militar      @relation(fields: [militarId], references: [id], onDelete: Restrict)

  @@index([eventoId], map: "idx_entregas_custodio_evento")
  @@map("entregas_custodio_kit")
}

// Historial de correcciones de último minuto (militar de la entrega u
// operador CDA del kit): solo inserción (trigger en la migración), nunca se
// pierde el valor anterior.
model CorreccionCustodiaKit {
  id             String                  @id @default(uuid()) @db.Uuid
  kitId          String                  @map("kit_id") @db.Uuid
  campo          CampoCorreccionCustodia
  valorAnterior  String?                 @map("valor_anterior") @db.Uuid
  valorNuevo     String                  @map("valor_nuevo") @db.Uuid
  motivo         String                  @db.VarChar(500)
  corregidoPorId String                  @map("corregido_por_id") @db.Uuid
  corregidoEn    DateTime                @default(now()) @map("corregido_en") @db.Timestamptz(6)

  kit KitElectoral @relation(fields: [kitId], references: [id], onDelete: Restrict)

  @@index([kitId], map: "idx_correcciones_custodia_kit")
  @@map("correcciones_custodia_kit")
}

model RecepcionDpiKit {
  id            String   @id @default(uuid()) @db.Uuid
  kitId         String   @map("kit_id") @db.Uuid
  supervisorId  String   @map("supervisor_id") @db.Uuid
  items         Json
  observaciones String?  @db.VarChar(500)
  confirmadoEn  DateTime @default(now()) @map("confirmado_en") @db.Timestamptz(6)
  /// Se verificó cuando el celular del operador aún no enviaba la salida del recinto.
  salidaPendiente Boolean @default(false) @map("salida_pendiente")

  @@index([kitId], map: "idx_recepciones_dpi_kit")
  @@map("recepciones_dpi_kit")
}

model PosicionGps {
  id           BigInt   @id @default(autoincrement())
  operadorId   String   @map("operador_id") @db.Uuid
  eventoId     String   @map("evento_id") @db.Uuid
  ubicacion    Unsupported("geography(Point,4326)")
  capturadoEn  DateTime @map("capturado_en") @db.Timestamptz(6)
  recibidoEn   DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)

  @@index([operadorId, capturadoEn], map: "idx_posiciones_operador")
  @@map("posiciones_gps")
}

// =====================================================================
// INCIDENCIAS (HU14)
// =====================================================================
model Incidencia {
  id           String           @id @default(uuid()) @db.Uuid
  eventoId     String           @map("evento_id") @db.Uuid
  operadorId   String           @map("operador_id") @db.Uuid
  recintoId    String?          @map("recinto_id") @db.Uuid
  kitId        String?          @map("kit_id") @db.Uuid
  tipo         TipoIncidencia
  descripcion  String?
  fotoUrl      String?          @map("foto_url") @db.VarChar(512)
  ubicacion    Unsupported("geography(Point,4326)")?
  estado       EstadoIncidencia @default(ABIERTA)
  reportadoEn  DateTime         @default(now()) @map("reportado_en") @db.Timestamptz(6)
  desdeOffline Boolean          @default(false) @map("desde_offline")

  comentarios IncidenciaComentario[]

  @@index([eventoId], map: "idx_incidencias_evento")
  @@index([estado], map: "idx_incidencias_estado")
  @@map("incidencias")
}

model IncidenciaComentario {
  id            String   @id @default(uuid()) @db.Uuid
  incidenciaId  String   @map("incidencia_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  comentario    String
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)

  @@map("incidencia_comentarios")
}

// =====================================================================
// ALERTAS (HU18)
// =====================================================================
model Alerta {
  id          String       @id @default(uuid()) @db.Uuid
  eventoId    String       @map("evento_id") @db.Uuid
  operadorId  String?      @map("operador_id") @db.Uuid
  kitId       String?      @map("kit_id") @db.Uuid
  tipo        TipoAlerta
  mensaje     String       @db.VarChar(255)
  estado      EstadoAlerta @default(GENERADA)
  generadaEn  DateTime     @default(now()) @map("generada_en") @db.Timestamptz(6)

  @@index([eventoId, estado], map: "idx_alertas_evento")
  @@map("alertas")
}

// =====================================================================
// NOTIFICACIONES (HU19)
// =====================================================================
model PreferenciaNotificacion {
  usuarioId  String  @map("usuario_id") @db.Uuid
  tipoEvento String  @map("tipo_evento") @db.VarChar(60)
  porPush    Boolean @default(true) @map("por_push")
  porEmail   Boolean @default(true) @map("por_email")

  @@id([usuarioId, tipoEvento])
  @@map("preferencias_notificacion")
}

model Notificacion {
  id         String             @id @default(uuid()) @db.Uuid
  usuarioId  String             @map("usuario_id") @db.Uuid
  tipoEvento String             @map("tipo_evento") @db.VarChar(60)
  canal      CanalNotificacion
  estado     EstadoNotificacion @default(ENCOLADA)
  intentos   Int                @default(0)
  payload    Json?
  creadoEn   DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)
  enviadoEn  DateTime?          @map("enviado_en") @db.Timestamptz(6)
  leidaEn    DateTime?          @map("leida_en") @db.Timestamptz(6)

  @@index([usuarioId], map: "idx_notificaciones_usuario")
  @@map("notificaciones")
}

// =====================================================================
// ENLACES CDAs (monitoreo de conectividad, independiente de eventoId)
// =====================================================================

enum EstadoEnlace {
  ACTIVO
  FALLO

  @@map("estado_enlace")
}

model EnlaceRecinto {
  codigoRecinto  String        @id @map("codigo_recinto") @db.VarChar(20)
  nombreRecinto  String        @map("nombre_recinto") @db.VarChar(255)
  canton         String?       @db.VarChar(100)
  estado         EstadoEnlace  @default(ACTIVO)
  estadoAnterior EstadoEnlace? @map("estado_anterior")
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("enlaces_recinto")
}

model ConfigEnlaces {
  id             Int      @id @default(1)
  correos        String[] @default([])
  /// Desde cuándo se registra el historial de caídas (antes no hay datos).
  historialDesde DateTime @default(now()) @map("historial_desde") @db.Timestamptz(6)
  /// Avisos por Telegram de enlaces caídos: el primero a los N min de caído,
  /// luego cada M min mientras siga caído. Se cambian desde la web.
  minutosPrimerAviso  Int @default(120) @map("minutos_primer_aviso")
  minutosRepetirAviso Int @default(120) @map("minutos_repetir_aviso")

  @@map("config_enlaces")
}

/// Una caída de enlace: de ACTIVO a FALLO (`inicio`) hasta que vuelve a ACTIVO
/// (`fin`; null mientras sigue caído). Copia nombre y cantón para que el
/// historial sobreviva aunque el recinto salga de la hoja. Precisión: 5 min
/// (frecuencia del cron). A lo más una caída abierta por recinto
/// (índice único parcial uq_enlaces_caidas_abierta, en su migración).
model EnlaceCaida {
  id            String    @id @default(uuid()) @db.Uuid
  codigoRecinto String    @map("codigo_recinto") @db.VarChar(20)
  nombreRecinto String    @map("nombre_recinto") @db.VarChar(255)
  canton        String?   @db.VarChar(100)
  inicio        DateTime  @db.Timestamptz(6)
  fin           DateTime? @db.Timestamptz(6)
  /// Último aviso de escalamiento (30 min caído) mandado a Telegram; null = aún no.
  ultimoAviso   DateTime? @map("ultimo_aviso") @db.Timestamptz(6)
  /// Cuántos avisos de escalamiento se mandaron por esta caída.
  avisos        Int       @default(0)

  @@index([inicio], map: "idx_enlaces_caidas_inicio")
  @@index([codigoRecinto], map: "idx_enlaces_caidas_recinto")
  @@map("enlaces_caidas")
}

// =====================================================================
// OPERADORES CDA — personal de servicio de los Centros de Digitalización
// de Actas. No son usuarios del sistema (no inician sesión): se importan
// del Excel de talento humano y solo se les toma asistencia, foto y acta.
// =====================================================================

enum EstadoPrenda {
  NUEVO
  BUENO
  REGULAR
  MALO

  @@map("estado_prenda")
}

enum EstadoActaCda {
  GENERADA
  FIRMADA

  @@map("estado_acta_cda")
}

/// Columnas tal cual vienen en el Excel (fila de encabezados "N°, Apellidos
/// Nombres, Cédula, Teléfonos De Contacto, Cargo, Unidad, Inicial"). El nombre
/// llega en una sola columna "APELLIDOS NOMBRES" y no se puede partir con
/// seguridad (hay apellidos compuestos), por eso se guarda entero.
/// Cargos del personal CDA y CPE (combo "Cargo"): misma gestión, listas
/// separadas. Las 9 claves originales (OPERADOR, ASISTENTE, ...) se conservan;
/// el administrador agrega más. No se borran: se desactivan (el personal y su
/// historial siguen colgando de la clave).
model CargoCda {
  clave         String   @id @db.VarChar(40)
  nombre        String   @db.VarChar(80)
  /// CDA o CPE (sección del combo, actas y carnets). No cambia.
  centro        String   @db.VarChar(3)
  activo        Boolean  @default(true)
  orden         Int
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  personal        OperadorCda[]
  configAsistencia ConfigAsistenciaCda[]
  cambiosDesde    CambioCargoCda[] @relation("CambioCargoCdaAnterior")
  cambiosHacia    CambioCargoCda[] @relation("CambioCargoCdaNuevo")
  actas           ActaEntregaCda[]

  @@map("cargos_cda")
}

model OperadorCda {
  id               String    @id @default(uuid()) @db.Uuid
  grupo            String    @default("OPERADOR") @db.VarChar(40)
  cargoCda         CargoCda  @relation(fields: [grupo], references: [clave], onUpdate: Cascade, onDelete: Restrict)
  numero           Int?
  apellidosNombres String    @map("apellidos_nombres") @db.VarChar(200)
  cedula           String    @unique @db.VarChar(10)
  telefono         String?   @db.VarChar(20)
  cargo            String    @db.VarChar(160)
  unidad           String?   @db.VarChar(200)
  fechaInicio      DateTime? @map("fecha_inicio") @db.Date
  /// Clave del archivo cifrado en Storage (null = aún no sube su foto).
  fotoKey          String?   @map("foto_key") @db.VarChar(255)
  fotoSubidaEn     DateTime? @map("foto_subida_en") @db.Timestamptz(6)
  activo           Boolean   @default(true)
  /// Celular de la persona: ANDROID o IPHONE (la APK solo se instala en Android).
  dispositivo      String?   @db.VarChar(10)
  /// Cuenta de la app (solo grupos OPERADOR y ASISTENTE).
  usuarioId        String?   @unique @map("usuario_id") @db.Uuid
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  asistencias AsistenciaCda[]
  enlacesFoto  EnlaceFotoCda[]
  actas        ActaEntregaCda[]
  credenciales CredencialQrCda[]
  cambiosCargo CambioCargoCda[]
  parejasComoOperador  ParejaCda[] @relation("ParejaCdaOperador")
  parejasComoAsistente ParejaCda[] @relation("ParejaCdaAsistente")

  @@index([grupo, activo])
  @@map("operadores_cda")
}

/// Una fila por operador y día: check de entrada y de salida con hora y
/// quién lo marcó (web hoy, APK después).
model AsistenciaCda {
  id            String    @id @default(uuid()) @db.Uuid
  operadorId    String    @map("operador_id") @db.Uuid
  fecha         DateTime  @db.Date
  entradaEn     DateTime? @map("entrada_en") @db.Timestamptz(6)
  entradaPorId  String?   @map("entrada_por_id") @db.Uuid
  salidaEn      DateTime? @map("salida_en") @db.Timestamptz(6)
  salidaPorId   String?   @map("salida_por_id") @db.Uuid
  /// Cómo se registró cada marca: MANUAL (check), MASIVA, QR o CORRECCION (día pasado). Null en marcas anteriores a la columna.
  entradaOrigen String?   @map("entrada_origen") @db.VarChar(10)
  salidaOrigen  String?   @map("salida_origen") @db.VarChar(10)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  operador   OperadorCda @relation(fields: [operadorId], references: [id], onDelete: Restrict)
  entradaPor Usuario?    @relation("AsistenciaCdaEntradaPor", fields: [entradaPorId], references: [id])
  salidaPor  Usuario?    @relation("AsistenciaCdaSalidaPor", fields: [salidaPorId], references: [id])

  @@unique([operadorId, fecha], map: "uq_asistencias_cda_operador_fecha")
  @@index([fecha], map: "idx_asistencias_cda_fecha")
  @@map("asistencias_cda")
}

/// Singleton (id = 1): hora oficial de entrada de los operadores CDA y minutos
/// de gracia. Entrada hasta hora + gracia = puntual; después, atraso. Quién lo
/// cambió queda en la bitácora (ASISTENCIA_CDA_CONFIG).
model ConfigAsistenciaCda {
  /// Una fila por grupo (hora y gracia propias).
  grupo         String   @id @db.VarChar(40)
  cargoCda      CargoCda @relation(fields: [grupo], references: [clave], onUpdate: Cascade, onDelete: Restrict)
  /// "HH:MM" en hora de Ecuador.
  horaEntrada   String   @default("08:00") @map("hora_entrada") @db.VarChar(5)
  minutosGracia Int      @default(10) @map("minutos_gracia")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("config_asistencia_cda")
}

/// Enlace personal para que el operador suba su foto desde el celular.
/// Solo se guarda el SHA-256 del token; de un solo uso y con caducidad.
model EnlaceFotoCda {
  id          String    @id @default(uuid()) @db.Uuid
  operadorId  String    @map("operador_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiraEn    DateTime  @map("expira_en") @db.Timestamptz(6)
  usadoEn     DateTime? @map("usado_en") @db.Timestamptz(6)
  /// Se llena al generar otro enlace para el mismo operador (solo vale el último).
  revocadoEn  DateTime? @map("revocado_en") @db.Timestamptz(6)
  /// Subidas rechazadas (archivo inválido). Al llegar al máximo el enlace se bloquea.
  intentos    Int       @default(0)
  /// Prueba del consentimiento LOPDP: cuándo y qué versión del aviso aceptó.
  consentidoEn          DateTime? @map("consentido_en") @db.Timestamptz(6)
  consentimientoVersion String?   @map("consentimiento_version") @db.VarChar(20)
  creadoPorId String?   @map("creado_por_id") @db.Uuid
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  operador  OperadorCda @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  creadoPor Usuario?    @relation("EnlaceFotoCdaCreadoPor", fields: [creadoPorId], references: [id])

  @@index([operadorId], map: "idx_enlaces_foto_cda_operador")
  @@map("enlaces_foto_cda")
}

/// Credencial QR del operador (carnet) para registrar entrada y salida.
/// Solo se guarda el SHA-256 del token: reimprimir es emitir otra y la anterior
/// queda revocada. Una sola vigente por operador (índice único parcial en SQL).
model CredencialQrCda {
  id               String    @id @default(uuid()) @db.Uuid
  operadorId       String    @map("operador_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  /// Token cifrado (AES-256-GCM con CARNET_TOKEN_KEY) para reimprimir sin anular. Null = emitido antes o sin clave.
  tokenCifrado     String?   @map("token_cifrado") @db.VarChar(120)
  emitidaEn        DateTime  @default(now()) @map("emitida_en") @db.Timestamptz(6)
  emitidaPorId     String?   @map("emitida_por_id") @db.Uuid
  revocadaEn       DateTime? @map("revocada_en") @db.Timestamptz(6)
  /// REEMITIDA (se imprimió otra) o REVOCADA (anulada a mano).
  motivoRevocacion String?   @map("motivo_revocacion") @db.VarChar(20)

  operador   OperadorCda @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  emitidaPor Usuario?    @relation("CredencialQrCdaEmitidaPor", fields: [emitidaPorId], references: [id])

  @@index([operadorId], map: "idx_credenciales_qr_cda_operador")
  @@map("credenciales_qr_cda")
}

/// Historial de cambios de cargo: con él se sabe en qué cargo estaba cada
/// persona cada día (la asistencia anterior al cambio queda en el cargo de
/// antes). Rige desde `desde` inclusive.
model CambioCargoCda {
  id            String   @id @default(uuid()) @db.Uuid
  operadorId    String   @map("operador_id") @db.Uuid
  grupoAnterior String   @map("grupo_anterior") @db.VarChar(40)
  grupoNuevo    String   @map("grupo_nuevo") @db.VarChar(40)
  desde         DateTime @db.Date
  hechoPorId    String?  @map("hecho_por_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  operador      OperadorCda @relation(fields: [operadorId], references: [id], onDelete: Restrict)
  hechoPor      Usuario?    @relation("CambioCargoCdaHechoPor", fields: [hechoPorId], references: [id])
  cargoAnterior CargoCda    @relation("CambioCargoCdaAnterior", fields: [grupoAnterior], references: [clave], onUpdate: Cascade, onDelete: Restrict)
  cargoNuevo    CargoCda    @relation("CambioCargoCdaNuevo", fields: [grupoNuevo], references: [clave], onUpdate: Cascade, onDelete: Restrict)

  @@index([operadorId, desde], map: "idx_cambios_cargo_cda_operador")
  @@index([grupoAnterior], map: "idx_cambios_cargo_cda_anterior")
  @@index([grupoNuevo], map: "idx_cambios_cargo_cda_nuevo")
  @@map("cambios_cargo_cda")
}

/// Acta de entrega de peto, credencial y cordón. Quien entrega se copia
/// (nombre, cédula, cargo) porque el acta es un documento: no debe cambiar
/// si luego cambia el usuario.
model ActaEntregaCda {
  id               String        @id @default(uuid()) @db.Uuid
  operadorId       String        @map("operador_id") @db.Uuid
  entregaPorId     String?       @map("entrega_por_id") @db.Uuid
  entregaNombre    String        @map("entrega_nombre") @db.VarChar(200)
  entregaCedula    String        @map("entrega_cedula") @db.VarChar(10)
  entregaCargo     String        @map("entrega_cargo") @db.VarChar(160)
  lugar            String        @default("Ibarra") @db.VarChar(80)
  fecha            DateTime      @db.Date
  estadoPeto       EstadoPrenda  @map("estado_peto")
  estadoCredencial EstadoPrenda  @map("estado_credencial")
  estadoCordon     EstadoPrenda  @map("estado_cordon")
  /// Cargo con el que se generó: el documento lo conserva aunque la persona cambie de cargo.
  grupo            String        @db.VarChar(40)
  estado           EstadoActaCda @default(GENERADA)
  firmadaEn        DateTime?     @map("firmada_en") @db.Timestamptz(6)
  creadoPorId      String?       @map("creado_por_id") @db.Uuid
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  operador   OperadorCda @relation(fields: [operadorId], references: [id], onDelete: Restrict)
  entregaPor Usuario?    @relation("ActaEntregaCdaEntregaPor", fields: [entregaPorId], references: [id])
  creadoPor  Usuario?    @relation("ActaEntregaCdaCreadoPor", fields: [creadoPorId], references: [id])
  cargoCda   CargoCda    @relation(fields: [grupo], references: [clave], onUpdate: Cascade, onDelete: Restrict)

  @@index([operadorId], map: "idx_actas_entrega_cda_operador")
  @@map("actas_entrega_cda")
}

// =====================================================================
// BITÁCORA DE AUDITORÍA (HU17) — append-only
// =====================================================================
model BitacoraAuditoria {
  id           BigInt   @id @default(autoincrement())
  usuarioId    String?  @map("usuario_id") @db.Uuid
  accion       String   @db.VarChar(80)
  entidad      String?  @db.VarChar(60)
  entidadId    String?  @map("entidad_id") @db.VarChar(60)
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  dispositivo  String?  @db.VarChar(160)
  ip           String?  @db.Inet
  ubicacion    Unsupported("geography(Point,4326)")?
  ocurridoEn   DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  @@index([usuarioId], map: "idx_bitacora_usuario")
  @@index([entidad, entidadId], map: "idx_bitacora_entidad")
  @@index([ocurridoEn], map: "idx_bitacora_fecha")
  @@map("bitacora_auditoria")
}

/// Pareja Operador CDA + Asistente CDA que va a un recinto un día dado
/// (pruebas técnicas, jornada). Normalmente una pareja por recinto; la
/// segunda en el mismo recinto y día solo queda registrada (el kit y la app
/// son de la primera). kitId = kit del evento activo asignado al operador.
model ParejaCda {
  id             String   @id @default(uuid()) @db.Uuid
  fecha          DateTime @db.Date
  recintoId      String   @map("recinto_id") @db.Uuid
  operadorCdaId  String   @map("operador_cda_id") @db.Uuid
  asistenteCdaId String?  @map("asistente_cda_id") @db.Uuid
  kitId          String?  @map("kit_id") @db.Uuid
  /// Artículos para crear el kit si el recinto no lo tiene ("CODIGO[:SERIE]", separados por coma).
  articulos      String?  @db.VarChar(1000)
  creadoPorId    String?  @map("creado_por_id") @db.Uuid
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  recinto   Recinto       @relation(fields: [recintoId], references: [id], onDelete: Restrict)
  operador  OperadorCda   @relation("ParejaCdaOperador", fields: [operadorCdaId], references: [id], onDelete: Restrict)
  asistente OperadorCda?  @relation("ParejaCdaAsistente", fields: [asistenteCdaId], references: [id], onDelete: Restrict)
  kit       KitElectoral? @relation(fields: [kitId], references: [id], onDelete: SetNull)
  creadoPor Usuario?      @relation("ParejaCdaCreadaPor", fields: [creadoPorId], references: [id])

  @@unique([fecha, operadorCdaId], map: "uq_parejas_cda_fecha_operador")
  @@unique([fecha, asistenteCdaId], map: "uq_parejas_cda_fecha_asistente")
  @@index([fecha, recintoId], map: "idx_parejas_cda_fecha_recinto")
  @@map("parejas_cda")
}
